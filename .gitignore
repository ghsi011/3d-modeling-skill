# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv*/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
/dist/
build/
*.egg-info/
.coverage
htmlcov/

# ---------------------------------------------------------------------------
# OS cruft
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Local render / scratch / CAD outputs at the repo root.
#
# These patterns are anchored to the repo root (leading slash) on purpose so
# they do NOT swallow the committed test fixtures that legitimately live under
# skills/3d-modeling/scripts/team_tools/examples/ (candidate_01.stl,
# reference_bar.stl). Keep generated artifacts out; keep fixtures in.
# ---------------------------------------------------------------------------
/*.stl
/*.step
/*.stp
/*.3mf
/*.obj
/*.gcode
/*.FCStd1
/*.FCBak
/preview*.png
/render*.png
/scratch/

# ---------------------------------------------------------------------------
# Agent orchestration scratch (plans, drafts, evidence, boulder/session state).
# Local working state only - never part of the shipped skill tree.
# ---------------------------------------------------------------------------
.omo/

# Per-machine Claude Code settings. Listed here rather than relying on a
# developer's global ignore file, which does not travel with a fresh clone.
.claude/settings.local.json

# ---------------------------------------------------------------------------
# uv lockfile. CI installs the light stack with pip and this repo ships a skill
# tree rather than a uv-managed application, so the lock is a local artifact.
# ---------------------------------------------------------------------------
uv.lock
temp/*